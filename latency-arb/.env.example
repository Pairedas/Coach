# ─────────────────────────────────────────────────────────────────────────────
# Copie ce fichier en .env et adapte-le. Ne versionne JAMAIS ton .env.
# Toutes les valeurs ci-dessous sont les valeurs par defaut du moteur.
# ─────────────────────────────────────────────────────────────────────────────

LOG_LEVEL=info
DASHBOARD=true
DASHBOARD_PORT=8787

# ── Flux spot ────────────────────────────────────────────────────────────────
BINANCE_SYMBOL=btcusdt
COINBASE_PRODUCT=BTC-USD
WEIGHT_BINANCE=0.65
WEIGHT_COINBASE=0.35
SPOT_STALENESS_MS=3000

# ── Marches Polymarket ───────────────────────────────────────────────────────
MARKET_KEYWORDS=bitcoin,btc
MAX_MARKETS=12
TAKER_FEE_BPS=0

# ── Modele ───────────────────────────────────────────────────────────────────
VOL_HALFLIFE_SEC=120
VOL_SAMPLE_MS=1000
VOL_MULTIPLIER=1.0
MODEL_UNCERTAINTY=0.01

# ── Strategie ────────────────────────────────────────────────────────────────
LAG_WINDOW_MS=4000
MIN_IMPULSE=0.02
MIN_BOOK_STALENESS_MS=500
MIN_EDGE=0.03
EXIT_EDGE=0.008
STOP_EDGE=0.05
MAX_HOLD_MS=300000
REPRICE_EXIT_TICKS=3
MIN_TTE_MS=90000
MAX_TTE_MS=21600000
KELLY_FRACTION=0.2

# ── Risque ───────────────────────────────────────────────────────────────────
BANKROLL=1000
MAX_POSITIONS=3
MAX_NOTIONAL_PER_MARKET=100
MAX_TOTAL_NOTIONAL=250
MIN_NOTIONAL=5
DAILY_LOSS_LIMIT=100
MAX_CONSECUTIVE_LOSSES=6

# ── Execution simulee ────────────────────────────────────────────────────────
SIM_LATENCY_MS=350
SIM_QUEUE_LOSS_PCT=0.5

# ── Execution reelle ─────────────────────────────────────────────────────────
# N'active ceci qu'apres avoir lu la section « Mode reel » du README.
# LIVE_TRADING=1
# LIVE_CONFIRM=JE COMPRENDS LES RISQUES
# POLYMARKET_PRIVATE_KEY=
# POLYMARKET_API_KEY=
# POLYMARKET_API_SECRET=
# POLYMARKET_API_PASSPHRASE=
# POLYMARKET_FUNDER=
